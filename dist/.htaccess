# Enable URL rewriting
RewriteEngine On
 
# Handle requests to static assets
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
 
# Rewrite short /api/... to /services/api/...
RewriteRule ^api/(.*)$ services/api/$1 [L,QSA]
 
# React SPA routing (all other routes go to index.html)
RewriteRule ^ index.html [L]
 
# Handle custom error documents
ErrorDocument 404 /index.html